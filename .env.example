# API key dari Apilogy: subscribe "Object Detection" (telkom_ai_dag, Free Plan, No Time Limit),
# lalu My Account -> Applications -> More -> Details -> Authentication Key -> Key-Auth -> Generate Key
APILOGY_API_KEY=

# Endpoint Object Detection (dari halaman Description API di apilogy.id)
OBJECT_DETECTION_URL=https://telkom-ai-dag.api.apilogy.id/Object_Detection/0.0.2/images/detect_objects

# Minimal tingkat keyakinan AI (0-1). Turunkan kalau benda sering tidak terdeteksi.
CONF_THRES=0.45

PORT=3000
